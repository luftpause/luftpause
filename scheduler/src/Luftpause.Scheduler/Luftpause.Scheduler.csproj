<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <ServerGarbageCollection>true</ServerGarbageCollection>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\Luftpause.Scheduling\Luftpause.Scheduling.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Grpc.AspNetCore" Version="2.84.0" />
  </ItemGroup>

  <ItemGroup>
    <EmbeddedResource Include="status.html" LogicalName="status.html" />
  </ItemGroup>

  <ItemGroup>
    <Protobuf Include="..\..\..\proto\luftpause\v1\scheduler.proto" ProtoRoot="..\..\..\proto" GrpcServices="Server" Link="Protos\scheduler.proto" />
  </ItemGroup>

</Project>
